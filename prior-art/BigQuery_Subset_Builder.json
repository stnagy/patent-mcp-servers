        "projectId": {
          "__rl": true,
          "mode": "id",
          "value": "REPLACE_WITH_YOUR_GCP_PROJECT_ID"
        },
        "sqlQuery": "SELECT cpc_prefix, COUNT(*) AS documents, MIN(publication_date) AS earliest, MAX(publication_date) AS latest, MAX(built_at) AS built_at FROM `REPLACE_WITH_YOUR_GCP_PROJECT_ID.prior_art.us_claims_by_cpc` GROUP BY cpc_prefix ORDER BY cpc_prefix",
        "options": {
          "location": "US",
          "maximumBytesBilled": "20000000000",
          "timeoutMs": 120000
        }
      },
      "id": "73582721-cfc9-4cdf-8406-66fd73358329",
      "name": "Report Subset Coverage",
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2.1,
      "position": [
