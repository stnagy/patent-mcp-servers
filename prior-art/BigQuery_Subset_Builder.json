        },
        "sqlQuery": "INSERT INTO `REPLACE_WITH_YOUR_GCP_PROJECT_ID.prior_art.us_claims_by_cpc`\n  (publication_number, country_code, publication_date, title, claims_text, cpc_prefix, built_at)\nSELECT\n  pub.publication_number,\n  pub.country_code,\n  pub.publication_date,\n  (SELECT t.text FROM UNNEST(pub.title_localized) AS t WHERE t.language = 'en' LIMIT 1) AS title,\n  (SELECT STRING_AGG(c.text, '\\n') FROM UNNEST(pub.claims_localized) AS c WHERE c.language = 'en') AS claims_text,\n  @cpcPrefix AS cpc_prefix,\n  CURRENT_TIMESTAMP() AS built_at\nFROM `patents-public-data.patents.publications` AS pub\nWHERE pub.country_code = 'US'\n  AND EXISTS (SELECT 1 FROM UNNEST(pub.cpc) AS cp WHERE STARTS_WITH(cp.code, @cpcPrefix))\n  AND EXISTS (SELECT 1 FROM UNNEST(pub.claims_localized) AS c WHERE c.language = 'en' AND c.text IS NOT NULL)",
        "options": {
          "location": "US",
          "maximumBytesBilled": "250000000000",
          "timeoutMs": 600000,
          "queryParameters": {
            "namedParameters": [
              {
                "name": "cpcPrefix",
                "value": "={{ $('Validate CPC Prefix').first().json.cpcPrefix }}"
              }
            ]
          }
        }
      },
      "id": "e9b7456d-0b46-4841-8db4-c39db68a42b2",
      "name": "Populate Subset From Public Data",
      "type": "n8n-nodes-base.googleBigQuery",
      "typeVersion": 2.1,
      "position": [
        0,
        304
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
